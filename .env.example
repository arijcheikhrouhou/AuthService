# Copier en .env (non versionné) et renseigner les valeurs
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=auth_db;encrypt=true;trustServerCertificate=true
DB_USERNAME=auth_app
DB_PASSWORD=
# Au moins 32 caractères aléatoires : openssl rand -base64 48
JWT_SECRET=
REDIS_HOST=localhost
REDIS_PORT=6379
